type HeaderField = record { text; text };

type HttpRequest = record {
  method : text;
  url : text;
  headers : vec HeaderField;
  body : blob;
};

type StreamingCallbackToken = record {
  key : text;
  content_encoding : text;
  index : nat;
  sha256 : opt blob;
};

type StreamingCallbackHttpResponse = record {
  body : blob;
  token : opt StreamingCallbackToken;
};

type StreamingStrategy = variant {
  Callback : record {
    callback : func (StreamingCallbackToken) -> (StreamingCallbackHttpResponse) query;
    token : StreamingCallbackToken;
  };
};

type HttpResponse = record {
  status_code : nat16;
  headers : vec HeaderField;
  body : blob;
  upgrade : opt bool;
  streaming_strategy : opt StreamingStrategy;
};

type Result = variant { Ok; Err : text };
type ResultText = variant { Ok : text; Err : text };
type ResultBlob = variant { Ok : blob; Err : text };

type CompileInfo = record { wasm_len : nat64; sha256_hex : text };
type ResultCompileInfo = variant { Ok : CompileInfo; Err : text };

type MeteredCompile = record {
  wasm_len : nat64;
  sha256_hex : text;
  instructions : nat64;
};
type ResultMetered = variant { Ok : MeteredCompile; Err : text };
type MeasureResult = record { funcs : nat32; wasm_len : nat64; instructions : nat64 };
type ResultMeasure = variant { Ok : MeasureResult; Err : text };
type JobProgress = record {
  done : bool;
  done_funcs : nat32;
  total_funcs : nat32;
  instructions : nat64;
};
type ResultJob = variant { Ok : JobProgress; Err : text };
type ResultNat64 = variant { Ok : nat64; Err : text };

type DeployMode = variant { upgrade; reinstall };
type DeployConfig = record {
  target : text;
  source_path : text;
  mode : DeployMode;
};
type DeployStatus = record {
  commit : text;
  ok : bool;
  message : text;
  wasm_len : nat64;
  wasm_sha256 : text;
};
type ResultDeployStatus = variant { Ok : DeployStatus; Err : text };

service : {
  // git smart-HTTP surface (called by the HTTP gateway)
  http_request : (HttpRequest) -> (HttpResponse) query;
  http_request_update : (HttpRequest) -> (HttpResponse);
  http_request_streaming_callback : (StreamingCallbackToken) -> (StreamingCallbackHttpResponse) query;

  // admin API (authorized principals only)
  create_repo : (text) -> (Result);
  put_object : (text, blob) -> (ResultText);
  set_ref : (text, text, text) -> (Result);
  create_push_token : (text) -> (ResultText);
  revoke_push_token : (text) -> (bool);

  // public reads
  get_object : (text) -> (opt blob) query;
  list_refs : (text) -> (vec record { text; text }) query;
  list_repos : () -> (vec text) query;

  // on-chain build: R0 WAT assembler
  compile_wat : (text) -> (ResultBlob) query;
  compile_wat_info : (text) -> (ResultCompileInfo) query;

  // on-chain build: R1 minimal language compiler
  compile_lang : (text) -> (ResultBlob) query;
  compile_lang_info : (text) -> (ResultCompileInfo) query;

  // R2: metering, ceiling measurement, resumable compile
  compile_lang_metered : (text) -> (ResultMetered);
  measure_compile : (nat32) -> (ResultMeasure);
  compile_job_start : (text) -> (ResultNat64);
  compile_job_step : (nat64, nat32) -> (ResultJob);
  compile_job_take : (nat64) -> (ResultBlob);

  // R3: separate compilation across modules
  compile_module : (text) -> (ResultBlob) query;
  link_module_objects : (vec blob) -> (ResultBlob) query;
  compile_and_link_info : (vec text) -> (ResultCompileInfo) query;

  // deploy-on-push (m4)
  set_wasm_deploy : (text, text, text) -> (Result);
  set_deploy_mode : (text, text) -> (Result);
  deploy_now : (text) -> (ResultDeployStatus);
  get_deploy_config : (text) -> (opt DeployConfig) query;
  get_deploy_status : (text) -> (opt DeployStatus) query;
  deploy_queue_len : () -> (nat64) query;
}
