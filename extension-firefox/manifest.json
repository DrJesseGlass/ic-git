{
  "manifest_version": 3,
  "name": "ic-git verifier",
  "version": "0.2.0",
  "description": "Checks ic-git sites against their on-chain record, lets a page load only if what arrived is the recorded page running only its verified scripts, and lets it call only approved canisters.",
  "browser_specific_settings": {
    "gecko": {
      "id": "verifier@ic-git.dev",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "browsingActivity"
        ]
      }
    }
  },
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "webRequestFilterResponse",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://umobs-yiaaa-aaaab-agyrq-cai.raw.icp0.io/*",
    "https://icp-api.io/*",
    "https://ethereum-sepolia-rpc.publicnode.com/*",
    "https://sepolia.gateway.tenderly.co/*",
    "https://icp0.io/*",
    "https://*.icp0.io/*",
    "https://ic0.app/*",
    "https://*.ic0.app/*"
  ],
  "background": {
    "scripts": [
      "bls12-381.js",
      "verifier.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://umobs-yiaaa-aaaab-agyrq-cai.raw.icp0.io/site/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "ic-git verifier"
  }
}
